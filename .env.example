PORT=3000
# replicaSet=rs0 es necesario para las transacciones (docker-compose ya levanta Mongo así).
# Con MongoDB Atlas usa la cadena mongodb+srv:// que te da Atlas.
MONGODB_URI=mongodb://localhost:27017/turnhub?replicaSet=rs0&directConnection=true
NODE_ENV=development
# Cambia este valor; en producción es obligatorio.
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
